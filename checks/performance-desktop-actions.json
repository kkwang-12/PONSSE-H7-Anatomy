[
  [
    "eval",
    "h7Demo.ready.then(()=>{if(h7Demo.renderer.type!=='canvas')throw new Error('cache renderer unavailable');if(document.querySelectorAll('[data-part]').length!==11)throw new Error('component tags');return {...h7Demo.renderer,nodes:document.querySelectorAll('*').length}})"
  ],
  [
    "shot",
    "shots/performance-assembled-dark.png",
    "body",
    1
  ],
  [
    "move",
    "#stage",
    0.14,
    0.3
  ],
  [
    "until",
    "h7Demo.state.progress===1",
    10000
  ],
  [
    "eval",
    "(()=>{if(h7Demo.state.manualOpen)throw new Error('hover must not pin');return {hoverExpanded:h7Demo.state.progress}})()"
  ],
  [
    "shot",
    "shots/performance-exploded-dark.png",
    ".h7",
    1
  ],
  [
    "move",
    ".h7-title",
    0.5,
    0.5
  ],
  [
    "until",
    "h7Demo.state.progress===0",
    10000
  ],
  [
    "eval",
    "({leaveReset:h7Demo.state.progress})"
  ],
  [
    "scroll",
    "[data-part='saw']"
  ],
  [
    "move",
    "[data-part='saw']",
    0.5,
    0.5
  ],
  [
    "until",
    "h7Demo.state.progress===1&&h7Demo.state.selected==='saw'",
    10000
  ],
  [
    "eval",
    "(()=>{if(!document.querySelector('#caption').textContent.includes('张紧'))throw new Error('new detail description');return {labelSelected:h7Demo.state.selected,caption:document.querySelector('#caption').textContent}})()"
  ],
  [
    "shot",
    "shots/performance-selected-dark.png",
    ".h7",
    1
  ],
  [
    "key",
    "Escape",
    "[data-part='saw']"
  ],
  [
    "until",
    "h7Demo.state.progress===0",
    10000
  ],
  [
    "key",
    "ArrowRight",
    "#stage"
  ],
  [
    "until",
    "h7Demo.state.selected==='frame'&&h7Demo.state.progress===1",
    10000
  ],
  [
    "key",
    "End",
    "#stage"
  ],
  [
    "eval",
    "(()=>{if(h7Demo.state.selected!=='saw')throw new Error('keyboard last');return {keyboardLast:h7Demo.state.selected}})()"
  ],
  [
    "key",
    "Escape",
    "#stage"
  ],
  [
    "until",
    "h7Demo.state.progress===0",
    10000
  ],
  [
    "scroll",
    "#toggle"
  ],
  [
    "click",
    "#toggle"
  ],
  [
    "until",
    "h7Demo.state.progress===1",
    10000
  ],
  [
    "move",
    ".h7-title",
    0.5,
    0.5
  ],
  [
    "wait",
    500
  ],
  [
    "eval",
    "(()=>{if(!h7Demo.state.manualOpen||h7Demo.state.progress!==1)throw new Error('explicit toggle must pin');return {manualPin:true}})()"
  ],
  [
    "scroll",
    "#toggle"
  ],
  [
    "click",
    "#toggle"
  ],
  [
    "until",
    "h7Demo.state.progress===0",
    10000
  ],
  [
    "eval",
    "(()=>{if(document.documentElement.scrollWidth>innerWidth)throw new Error('horizontal overflow');return {reset:true,overflow:false}})()"
  ]
]