[
  ["eval", "h7Demo.target(0); ({solids:document.querySelectorAll('.part').length,assemblies:h7Demo.assemblies.length})"],
  ["until", "h7Demo.state.progress === 0"],
  ["shot", "shots/assembled.png", "body", 1],
  ["click", "#explode"],
  ["until", "h7Demo.state.progress === 1", 10000],
  ["eval", "({progress:h7Demo.state.progress, text:document.querySelector('#readout').textContent, viewBox:document.querySelector('#machine').getAttribute('viewBox')})"],
  ["shot", "shots/exploded.png", "body", 1],
  ["click", ".assembly-row[data-id='feedR']"],
  ["eval", "({selected:h7Demo.state.selected, title:document.querySelector('#detail-title').textContent,dimmed:document.querySelectorAll('.part[style*=\"0.19\"]').length})"],
  ["shot", "shots/selected.png", ".workspace", 1],
  ["click", "#clear-selection"],
  ["click", "#theme"],
  ["shot", "shots/dark.png", "body", 1],
  ["click", "#theme"],
  ["key", "Home", "#stage"],
  ["until", "h7Demo.state.progress === 0", 10000],
  ["key", "ArrowRight", "#stage"],
  ["until", "Math.abs(h7Demo.state.progress-.1)<.0003", 10000],
  ["eval", "({keyboardProgress:h7Demo.state.progress})"],
  ["click", "#references"],
  ["until", "[...document.querySelectorAll('dialog img')].every(i=>i.complete&&i.naturalWidth>0)", 10000],
  ["eval", "({dialog:document.querySelector('dialog').open, images:[...document.querySelectorAll('dialog img')].map(i=>({ok:i.complete&&i.naturalWidth>0,src:i.getAttribute('src')}))})"],
  ["shot", "shots/references.png", "dialog", 1],
  ["click", "#close-references"],
  ["scroll", "#play"],
  ["click", "#play"],
  ["wait", 2800],
  ["eval", "(()=>{if(!h7Demo.state.playing)throw new Error('Auto demo did not start');return {playing:h7Demo.state.playing,progress:h7Demo.state.progress}})()"],
  ["click", "#play"],
  ["eval", "(()=>{if(h7Demo.state.playing)throw new Error('Auto demo did not pause');return {paused:!h7Demo.state.playing,horizontalOverflow:document.documentElement.scrollWidth>innerWidth}})()"]
]
